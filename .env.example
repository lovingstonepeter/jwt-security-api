# Copy these into your shell / IDE run configuration. Spring Boot does not read .env files by itself.
JWT_SECRET=<base64 string, at least 32 bytes>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong password>
# Only when using a real database:
# DB_URL=jdbc:postgresql://localhost:5432/jwtdb
# DB_USERNAME=postgres
# DB_PASSWORD=<database password>
