{
  "info": {
    "name": "JWT Security API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": "set-your-ADMIN_PASSWORD-here"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register (public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john\",\n  \"password\": \"Password123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login as john (USER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john\",\n  \"password\": \"Password123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login ok\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login ok\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Change my password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me",
                "password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"NewPassword123\"\n}"
            }
          }
        },
        {
          "name": "List all users (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          }
        },
        {
          "name": "Delete user by id (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "2"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Players",
      "item": [
        {
          "name": "List players (any logged-in user)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/players",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "players"
              ]
            }
          }
        },
        {
          "name": "Create player (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/players",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "players"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sadio Mane\",\n  \"jerseyNumber\": 10,\n  \"position\": \"Forward\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"playerId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get player by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/players/{{playerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "players",
                "{{playerId}}"
              ]
            }
          }
        },
        {
          "name": "Update player (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/players/{{playerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "players",
                "{{playerId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sadio Mane\",\n  \"jerseyNumber\": 11,\n  \"position\": \"Winger\"\n}"
            }
          }
        },
        {
          "name": "Delete player (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/players/{{playerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "players",
                "{{playerId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Error cases",
      "item": [
        {
          "name": "No token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/players",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "players"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Validation error -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/players",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "players"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"jerseyNumber\": 500\n}"
            }
          }
        },
        {
          "name": "Player not found -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/players/99999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "players",
                "99999"
              ]
            }
          }
        }
      ]
    }
  ]
}